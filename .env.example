# ==============================================================================
# 🏗️ ModularHome - Environment Configuration (.env.example)
# Copy this file to `.env` or `.env.local` and fill in your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Convex Backend Configuration
# ------------------------------------------------------------------------------
# Run `npx convex dev` to initialize your local/cloud Convex backend deployment.
NEXT_PUBLIC_CONVEX_URL="https://dummy-convex-url.convex.cloud"
CONVEX_DEPLOYMENT=""

# ------------------------------------------------------------------------------
# 2. Admin Authentication & Security
# ------------------------------------------------------------------------------
ADMIN_SESSION_SECRET="modularhome_secure_jwt_session_secret_key_2026_change_in_production"
ADMIN_DEFAULT_EMAIL="admin@modularhome.com"
ADMIN_DEFAULT_PASSWORD="Admin@ModularHome2026!"

# ------------------------------------------------------------------------------
# 3. Public Site URL & Global Defaults
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_COMPANY_NAME="ModularHome.com"
NEXT_PUBLIC_CONTACT_PHONE="+1 (812) 595-4033"
NEXT_PUBLIC_CONTACT_EMAIL="contact@modularhome.com"

# ------------------------------------------------------------------------------
# 4. YouTube Data API v3 (Building Tours & Factory Walkthroughs)
# ------------------------------------------------------------------------------
# Get your API key from https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=""
YOUTUBE_CHANNEL_ID=""

# ------------------------------------------------------------------------------
# 5. Email & Notifications (Optional)
# ------------------------------------------------------------------------------
RESEND_API_KEY=""
ADMIN_NOTIFICATION_EMAIL="leads@modularhome.com"
